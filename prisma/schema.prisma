generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  WARDEN
  WORKER
  ADMIN
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CLOSED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Category {
  PLUMBING
  ELECTRICAL
  CARPENTRY
  WIFI
  HOUSEKEEPING
  FURNITURE
  OTHER
}

model Hostel {
  id        String   @id @default(cuid())
  name      String
  block     String
  city      String   @default("Campus")
  createdAt DateTime @default(now())
  users     User[]
  tickets   Ticket[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(STUDENT)
  phone        String?
  roomNumber   String?
  hostelId     String?
  hostel       Hostel?  @relation(fields: [hostelId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reported     Ticket[] @relation("Reporter")
  assigned     Ticket[] @relation("Assignee")
  events       TicketEvent[]
  alerts       Alert[]
}

model Ticket {
  id          String       @id @default(cuid())
  ref         String       @unique
  title       String
  description String
  category    Category
  priority    Priority     @default(MEDIUM)
  status      TicketStatus @default(OPEN)
  roomNumber  String
  photoUrl    String?
  hostelId    String
  hostel      Hostel       @relation(fields: [hostelId], references: [id])
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?
  rating      Int?
  ratingNote  String?
  events      TicketEvent[]
  alerts      Alert[]

  @@index([status, priority])
  @@index([hostelId])
  @@index([assigneeId])
  @@index([reporterId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  type      String
  message   String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Alert {
  id        String    @id @default(cuid())
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([ticketId])
}
