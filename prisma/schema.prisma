generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  WARDEN
  WORKER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Hostel {
  id        String   @id @default(cuid())
  name      String
  block     String
  users     User[]
  tickets   Ticket[]
  createdAt DateTime @default(now())
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(STUDENT)
  roomNo   String?
  phone    String?

  hostelId String?
  hostel   Hostel? @relation(fields: [hostelId], references: [id])

  tickets  Ticket[] @relation("ReportedBy")
  assigned Ticket[] @relation("AssignedTo")

  createdAt DateTime @default(now())
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String
  // plumbing, electrical, wifi etc for now
  category    String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  roomNo      String

  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id])

  createdById String
  createdBy   User   @relation("ReportedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
